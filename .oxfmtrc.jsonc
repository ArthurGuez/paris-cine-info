{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "objectWrap": "collapse",
  "sortImports": true,
  "sortPackageJson": { "sortScripts": true },
  "sortTailwindcss": { "stylesheet": "./src/index.css" },
  "ignorePatterns": ["src/routeTree.gen.ts"],
}
